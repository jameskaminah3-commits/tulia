# Required by the API server.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mombasa_wellness

# Use a long, unique value. Required to open /ops and call operations endpoints.
OPS_API_KEY=replace-with-a-long-random-secret

# Required in production when the web app and API use different origins.
# CORS_ORIGIN=https://app.example.com

