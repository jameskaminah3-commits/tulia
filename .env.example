# Supabase client values - safe only when exposed with the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Legacy Express prototype configuration. Do not use this service for production traffic.
